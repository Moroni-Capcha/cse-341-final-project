            "description": ""
          }
        }
      }
    },
    "/logout": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout user",
        "description": "Logs the user out and terminates the active session.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get authentication status",
        "description": "Returns JSON showing whether the client is authenticated and active user profile",
        "responses": {
          "200": {
            "description": "Authentication state",
            "schema": {
              "type": "object",
              "properties": {
                "authenticated": {
                  "type": "boolean",
                  "example": true
                },
                "user": {
                  "type": "object",
                  "properties": {
                    "username": {
                      "type": "string",
                      "example": "octocat"
                    },
                    "displayName": {
                      "type": "string",
                      "example": "The Octocat"
                    },
                    "id": {
                      "type": "string",
                      "example": "1"
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/users/": {
      "get": {
        "tags": [
          "Users"
        ],
        "description": "Retrieve all users from the database",
        "produces": [
          "application/json"
        ],
