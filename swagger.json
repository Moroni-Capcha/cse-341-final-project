    "/login": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Initiate GitHub OAuth login",
        "description": "Redirects user to GitHub for authentication. For testing, open this route directly in your browser tab.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/github/callback": {
      "get": {
        "tags": [
          "Auth"
        ],
